# Reject Qt in the actual target dependency graph without forbidding a separate
# application from using Qt elsewhere. Check direct links, generator-expression
# links, imported binary locations, include paths and propagated Qt definitions.
function(_iigeneraldocument_is_qt_reference property value result)
    string(TOLOWER "${value}" _value)
    set(_qt FALSE)
    if(_value MATCHES "(^|[^a-z0-9_])qt_[a-z0-9_]+_lib([^a-z0-9_]|$)"
            OR _value MATCHES "(^|[^a-z0-9_])qt[0-9]*::")
        set(_qt TRUE)
    elseif(property MATCHES "INCLUDE_DIRECTORIES$")
        if(_value MATCHES "(^|[/\\\\])(qt[0-9]*|qt[0-9]*(core|gui|widgets|network|qml|quick|xml|sql|concurrent|opengl|test|dbus|printsupport|svg|webengine|bluetooth|multimedia|charts))([/\\\\;>]|$)")
            set(_qt TRUE)
        endif()
    elseif(_value MATCHES "(^|[ ,;:=<>])(-l)?qt[0-9]*[a-z0-9_]*($|[ ,;<>])"
            OR _value MATCHES "(^|[/\\\\])(lib)?qt[0-9]*[a-z0-9_]*\\.(a|so|dylib|lib|dll|framework)([./\\\\;>]|$)")
        set(_qt TRUE)
    endif()
    set(${result} "${_qt}" PARENT_SCOPE)
endfunction()

function(iigeneraldocument_require_qt_free root)
    if(NOT TARGET "${root}")
        message(FATAL_ERROR "Unknown document target: ${root}")
    endif()
    set(_pending "${root}")
    set(_visited)
    while(_pending)
        list(POP_FRONT _pending _current)
        if(_current IN_LIST _visited)
            continue()
        endif()
        list(APPEND _visited "${_current}")
        if(NOT TARGET "${_current}")
            continue()
        endif()
        _iigeneraldocument_is_qt_reference("LINK_LIBRARIES" "${_current}" _qt_target)
        if(_qt_target)
            message(FATAL_ERROR "Qt dependency detected in ${root}: target ${_current}")
        endif()
        get_target_property(_aliased "${_current}" ALIASED_TARGET)
        if(_aliased AND NOT _aliased MATCHES "-NOTFOUND$")
            list(APPEND _pending "${_aliased}")
        endif()
        set(_properties LINK_LIBRARIES INTERFACE_LINK_LIBRARIES INTERFACE_LINK_OPTIONS
            LINK_OPTIONS INTERFACE_COMPILE_DEFINITIONS COMPILE_DEFINITIONS
            INTERFACE_INCLUDE_DIRECTORIES INCLUDE_DIRECTORIES IMPORTED_LOCATION IMPORTED_IMPLIB)
        get_target_property(_configs "${_current}" IMPORTED_CONFIGURATIONS)
        if(_configs AND NOT _configs MATCHES "-NOTFOUND$")
            foreach(_config IN LISTS _configs)
                string(TOUPPER "${_config}" _upper)
                list(APPEND _properties "IMPORTED_LOCATION_${_upper}" "IMPORTED_IMPLIB_${_upper}")
            endforeach()
        endif()
        list(APPEND _properties IMPORTED_LOCATION_NOCONFIG IMPORTED_IMPLIB_NOCONFIG
            IMPORTED_LOCATION_DEBUG IMPORTED_LOCATION_RELEASE IMPORTED_LOCATION_RELWITHDEBINFO
            IMPORTED_LOCATION_MINSIZEREL IMPORTED_IMPLIB_DEBUG IMPORTED_IMPLIB_RELEASE)
        foreach(_property IN LISTS _properties)
            get_target_property(_values "${_current}" "${_property}")
            if(NOT _values OR _values MATCHES "-NOTFOUND$")
                continue()
            endif()
            foreach(_value IN LISTS _values)
                _iigeneraldocument_is_qt_reference("${_property}" "${_value}" _qt_reference)
                if(_qt_reference)
                    message(FATAL_ERROR "Qt dependency detected in ${root}: ${_current}.${_property} references ${_value}")
                endif()
                # Also visit targets hidden inside LINK_ONLY/IF and other
                # generator expressions; cycles are bounded by _visited.
                string(REGEX MATCHALL "[A-Za-z_][A-Za-z0-9_+.-]*::[A-Za-z_][A-Za-z0-9_+.-]*|[A-Za-z_][A-Za-z0-9_+.-]*" _references "${_value}")
                foreach(_reference IN LISTS _references)
                    if(TARGET "${_reference}" AND NOT _reference IN_LIST _visited)
                        list(APPEND _pending "${_reference}")
                    endif()
                endforeach()
                if(TARGET "${_value}" AND NOT _value IN_LIST _visited)
                    list(APPEND _pending "${_value}")
                endif()
            endforeach()
        endforeach()
    endwhile()
endfunction()
