@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Prefer packages installed alongside this relocatable SDK package, then the
# explicitly configured SDK root and the standard user SDK directory.
foreach(_iigeneraldocument_sdk_root IN ITEMS
        "${PACKAGE_PREFIX_DIR}/.."
        "${IIGENERALDOCUMENT_LOCAL_LIBRARY_ROOT}"
        "$ENV{HOME}/.local/SDK")
    if(_iigeneraldocument_sdk_root STREQUAL "")
        continue()
    endif()
    foreach(_iigeneraldocument_dependency IN ITEMS iiXml iiHtmlBlock)
        if(EXISTS "${_iigeneraldocument_sdk_root}/${_iigeneraldocument_dependency}")
            list(APPEND CMAKE_PREFIX_PATH
                "${_iigeneraldocument_sdk_root}/${_iigeneraldocument_dependency}")
        endif()
    endforeach()
endforeach()
list(REMOVE_DUPLICATES CMAKE_PREFIX_PATH)
unset(_iigeneraldocument_sdk_root)
unset(_iigeneraldocument_dependency)

find_dependency(iiXml 0.1.0 CONFIG REQUIRED)
find_dependency(iiHtmlBlock 0.1.0 CONFIG REQUIRED)
find_dependency(Qt6 6.5 REQUIRED COMPONENTS Core)

if(APPLE AND TARGET WrapOpenGL::WrapOpenGL)
    get_target_property(iigeneraldocument_wrap_opengl_links
        WrapOpenGL::WrapOpenGL INTERFACE_LINK_LIBRARIES)
    if(iigeneraldocument_wrap_opengl_links)
        set(iigeneraldocument_filtered_wrap_opengl_links)
        foreach(iigeneraldocument_wrap_link IN LISTS iigeneraldocument_wrap_opengl_links)
            if(iigeneraldocument_wrap_link STREQUAL "-framework AGL"
                    OR iigeneraldocument_wrap_link MATCHES "AGL\\.framework")
                continue()
            endif()
            list(APPEND iigeneraldocument_filtered_wrap_opengl_links
                "${iigeneraldocument_wrap_link}")
        endforeach()
        set_property(TARGET WrapOpenGL::WrapOpenGL PROPERTY
            INTERFACE_LINK_LIBRARIES "${iigeneraldocument_filtered_wrap_opengl_links}")
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/iiGeneralDocumentTargets.cmake")

# Preserve runtime lookup when a shell's LIBRARY_PATH causes CMake to omit the
# package directory from the consumer's generated RPATH.
if(CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND TARGET iiGeneralDocument::iiGeneralDocument)
    get_filename_component(_iigeneraldocument_package_library_directory
        "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
    list(FIND CMAKE_CXX_IMPLICIT_LINK_DIRECTORIES
        "${_iigeneraldocument_package_library_directory}"
        _iigeneraldocument_implicit_link_directory_index)
    if(NOT _iigeneraldocument_implicit_link_directory_index EQUAL -1)
        set_property(TARGET iiGeneralDocument::iiGeneralDocument APPEND PROPERTY
            INTERFACE_LINK_OPTIONS
            "LINKER:-rpath,${_iigeneraldocument_package_library_directory}")
    endif()
    unset(_iigeneraldocument_package_library_directory)
    unset(_iigeneraldocument_implicit_link_directory_index)
endif()

check_required_components(iiGeneralDocument)
