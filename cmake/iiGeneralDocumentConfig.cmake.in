@PACKAGE_INIT@

# The Pdf component has only standard C++23 types and embeds its pinned OSS backend.
include("${CMAKE_CURRENT_LIST_DIR}/iiGeneralDocumentPdfTargets.cmake")
set(iiGeneralDocument_Pdf_FOUND TRUE)
# Restore the package runtime path when LIBRARY_PATH makes it implicit to CMake.
if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    get_filename_component(_pdf_library_directory "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
    list(FIND CMAKE_CXX_IMPLICIT_LINK_DIRECTORIES "${_pdf_library_directory}" _pdf_implicit_index)
    if(NOT _pdf_implicit_index EQUAL -1)
        set_property(TARGET iiGeneralDocument::Pdf APPEND PROPERTY
            INTERFACE_LINK_OPTIONS "LINKER:-rpath,${_pdf_library_directory}")
    endif()
    unset(_pdf_library_directory)
    unset(_pdf_implicit_index)
endif()
if("${iiGeneralDocument_FIND_COMPONENTS}" STREQUAL "Pdf" OR @IIGENERALDOCUMENT_PDF_ONLY@)
    foreach(_component IN LISTS iiGeneralDocument_FIND_COMPONENTS)
        if(NOT _component STREQUAL "Pdf")
            set(iiGeneralDocument_${_component}_FOUND FALSE)
        endif()
    endforeach()
    check_required_components(iiGeneralDocument)
    return()
endif()
include(CMakeFindDependencyMacro)

if(DEFINED IIGENERALDOCUMENT_LOCAL_LIBRARY_ROOT AND NOT IIGENERALDOCUMENT_LOCAL_LIBRARY_ROOT STREQUAL "")
    list(PREPEND CMAKE_PREFIX_PATH "${IIGENERALDOCUMENT_LOCAL_LIBRARY_ROOT}/iiFileProvider")
endif()
list(APPEND CMAKE_PREFIX_PATH "${PACKAGE_PREFIX_DIR}/../iiFileProvider" "$ENV{HOME}/.local/SDK/iiFileProvider")
find_dependency(iiFileProviderNative 0.5.0 CONFIG REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/iiGeneralDocumentTargets.cmake")

# Preserve runtime lookup when a shell's LIBRARY_PATH causes CMake to omit the
# package directory from the consumer's generated RPATH.
if(CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND TARGET iiGeneralDocument::iiGeneralDocument)
    get_filename_component(_iigeneraldocument_package_library_directory
        "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
    list(FIND CMAKE_CXX_IMPLICIT_LINK_DIRECTORIES
        "${_iigeneraldocument_package_library_directory}"
        _iigeneraldocument_implicit_link_directory_index)
    if(NOT _iigeneraldocument_implicit_link_directory_index EQUAL -1)
        set_property(TARGET iiGeneralDocument::iiGeneralDocument APPEND PROPERTY
            INTERFACE_LINK_OPTIONS
            "LINKER:-rpath,${_iigeneraldocument_package_library_directory}")
    endif()
    unset(_iigeneraldocument_package_library_directory)
    unset(_iigeneraldocument_implicit_link_directory_index)
endif()

check_required_components(iiGeneralDocument)
