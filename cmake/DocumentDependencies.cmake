file(READ "${CMAKE_CURRENT_SOURCE_DIR}/third_party/document-dependencies.json" _document_manifest)
string(JSON _document_count LENGTH "${_document_manifest}" files)
math(EXPR _document_last "${_document_count}-1")
foreach(_document_index RANGE 0 ${_document_last})
    string(JSON _document_file GET "${_document_manifest}" files ${_document_index} file)
    string(JSON _document_sha GET "${_document_manifest}" files ${_document_index} sha256)
    file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/third_party/${_document_file}" _document_actual)
    if(NOT _document_sha STREQUAL _document_actual)
        message(FATAL_ERROR "Pinned document dependency mismatch: ${_document_file}")
    endif()
endforeach()
