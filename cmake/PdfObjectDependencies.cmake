include(ExternalProject)

set(IIGENERALDOCUMENT_PDF_DEP_PREFIX "${CMAKE_BINARY_DIR}/pdf-object-deps/install")
file(MAKE_DIRECTORY "${IIGENERALDOCUMENT_PDF_DEP_PREFIX}/include")
set(dep_flags "")
if(NOT MSVC)
  set(dep_flags "-fPIC")
  if(IIGENERALDOCUMENT_PDF_SANITIZERS)
    string(APPEND dep_flags " -fsanitize=address,undefined -fno-omit-frame-pointer")
  endif()
endif()
set(dep_common
  -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE}
  -DCMAKE_INSTALL_PREFIX=${IIGENERALDOCUMENT_PDF_DEP_PREFIX}
  -DCMAKE_INSTALL_LIBDIR=lib
  -DCMAKE_POSITION_INDEPENDENT_CODE=ON
  -DCMAKE_CXX_STANDARD=23
  -DCMAKE_CXX_STANDARD_REQUIRED=ON
  -DCMAKE_CXX_EXTENSIONS=OFF
  -DCMAKE_C_FLAGS=${dep_flags}
  -DCMAKE_CXX_FLAGS=${dep_flags})
if(CMAKE_OSX_SYSROOT)
  list(APPEND dep_common -DCMAKE_OSX_SYSROOT=${CMAKE_OSX_SYSROOT})
endif()
if(CMAKE_OSX_ARCHITECTURES)
  list(APPEND dep_common -DCMAKE_OSX_ARCHITECTURES=${CMAKE_OSX_ARCHITECTURES})
endif()

ExternalProject_Add(iiGeneralDocumentPdfZlibBuild
  PREFIX "${CMAKE_BINARY_DIR}/pdf-object-deps/zlib"
  URL "${CMAKE_CURRENT_SOURCE_DIR}/third_party/archives/zlib-1.3.1.tar.gz"
  URL_HASH SHA256=9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23
  DOWNLOAD_EXTRACT_TIMESTAMP FALSE
  CMAKE_ARGS ${dep_common} -DZLIB_BUILD_EXAMPLES=OFF
  BUILD_COMMAND ${CMAKE_COMMAND} --build <BINARY_DIR> --target zlibstatic --parallel 4
  INSTALL_COMMAND ${CMAKE_COMMAND}
    -DSOURCE_DIR=<SOURCE_DIR> -DBINARY_DIR=<BINARY_DIR>
    -DDESTINATION=${IIGENERALDOCUMENT_PDF_DEP_PREFIX}
    -P ${CMAKE_CURRENT_SOURCE_DIR}/cmake/InstallPdfZlib.cmake
  BUILD_BYPRODUCTS "${IIGENERALDOCUMENT_PDF_DEP_PREFIX}/lib/${CMAKE_STATIC_LIBRARY_PREFIX}z${CMAKE_STATIC_LIBRARY_SUFFIX}")
ExternalProject_Add(iiGeneralDocumentPdfJpegBuild
  PREFIX "${CMAKE_BINARY_DIR}/pdf-object-deps/jpeg"
  URL "${CMAKE_CURRENT_SOURCE_DIR}/third_party/archives/libjpeg-turbo-3.2.0.tar.gz"
  URL_HASH SHA256=6f30092cef9fb839779646608f4ee14ae3cbac989c47fa05e841b0841f09878e
  DOWNLOAD_EXTRACT_TIMESTAMP FALSE
  CMAKE_ARGS ${dep_common} -DENABLE_SHARED=OFF -DENABLE_STATIC=ON
    -DWITH_TURBOJPEG=OFF -DWITH_SIMD=OFF -DWITH_TOOLS=OFF -DWITH_TESTS=OFF
  BUILD_COMMAND ${CMAKE_COMMAND} --build <BINARY_DIR> --target jpeg-static --parallel 4
  INSTALL_COMMAND ${CMAKE_COMMAND} --install <BINARY_DIR>
  BUILD_BYPRODUCTS "${IIGENERALDOCUMENT_PDF_DEP_PREFIX}/lib/${CMAKE_STATIC_LIBRARY_PREFIX}jpeg${CMAKE_STATIC_LIBRARY_SUFFIX}")
ExternalProject_Add(iiGeneralDocumentPdfQpdfBuild
  PREFIX "${CMAKE_BINARY_DIR}/pdf-object-deps/qpdf"
  DEPENDS iiGeneralDocumentPdfZlibBuild iiGeneralDocumentPdfJpegBuild
  URL "${CMAKE_CURRENT_SOURCE_DIR}/third_party/archives/qpdf-12.3.2.tar.gz"
  URL_HASH SHA256=6cba2f9f2cd887d905faeb99e0e51a307b217920d1bbf3e9cfbb2e8178a2deda
  DOWNLOAD_EXTRACT_TIMESTAMP FALSE
  CMAKE_ARGS ${dep_common} -DCXX_NEXT=ON -DBUILD_SHARED_LIBS=OFF -DBUILD_STATIC_LIBS=ON
    -DBUILD_DOC=OFF -DINSTALL_MANUAL=OFF -DINSTALL_EXAMPLES=OFF
    -DUSE_IMPLICIT_CRYPTO=OFF -DREQUIRE_CRYPTO_NATIVE=ON
    -DPKG_CONFIG_EXECUTABLE= -DPKG_CONFIG_FOUND=FALSE
    -DZLIB_H_PATH=${IIGENERALDOCUMENT_PDF_DEP_PREFIX}/include
    -DZLIB_LIB_PATH=${IIGENERALDOCUMENT_PDF_DEP_PREFIX}/lib/${CMAKE_STATIC_LIBRARY_PREFIX}z${CMAKE_STATIC_LIBRARY_SUFFIX}
    -DLIBJPEG_H_PATH=${IIGENERALDOCUMENT_PDF_DEP_PREFIX}/include
    -DLIBJPEG_LIB_PATH=${IIGENERALDOCUMENT_PDF_DEP_PREFIX}/lib/${CMAKE_STATIC_LIBRARY_PREFIX}jpeg${CMAKE_STATIC_LIBRARY_SUFFIX}
  BUILD_COMMAND ${CMAKE_COMMAND} --build <BINARY_DIR> --target libqpdf --parallel 4
  INSTALL_COMMAND ${CMAKE_COMMAND} --install <BINARY_DIR> --component dev
  BUILD_BYPRODUCTS "${IIGENERALDOCUMENT_PDF_DEP_PREFIX}/lib/${CMAKE_STATIC_LIBRARY_PREFIX}qpdf${CMAKE_STATIC_LIBRARY_SUFFIX}")

foreach(pair IN ITEMS "Qpdf;qpdf;iiGeneralDocumentPdfQpdfBuild" "Jpeg;jpeg;iiGeneralDocumentPdfJpegBuild" "Zlib;z;iiGeneralDocumentPdfZlibBuild")
  list(GET pair 0 target_name)
  list(GET pair 1 file_name)
  list(GET pair 2 build_name)
  add_library(iiGeneralDocumentPdf${target_name} STATIC IMPORTED GLOBAL)
  set_target_properties(iiGeneralDocumentPdf${target_name} PROPERTIES
    IMPORTED_LOCATION "${IIGENERALDOCUMENT_PDF_DEP_PREFIX}/lib/${CMAKE_STATIC_LIBRARY_PREFIX}${file_name}${CMAKE_STATIC_LIBRARY_SUFFIX}"
    INTERFACE_INCLUDE_DIRECTORIES "${IIGENERALDOCUMENT_PDF_DEP_PREFIX}/include")
  add_dependencies(iiGeneralDocumentPdf${target_name} ${build_name})
endforeach()
