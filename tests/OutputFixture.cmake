include("${CMAKE_CURRENT_LIST_DIR}/OutputLayoutTest.cmake")
if(IS_SYMLINK "${OUTPUT_DIR}")
    message(FATAL_ERROR "Document test output must not be a symlink")
endif()
if(ACTION STREQUAL "setup")
    file(MAKE_DIRECTORY "${OUTPUT_DIR}")
elseif(ACTION STREQUAL "cleanup")
    file(REMOVE_RECURSE "${OUTPUT_DIR}")
else()
    message(FATAL_ERROR "Unknown output fixture action")
endif()
