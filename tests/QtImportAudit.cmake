# Extract dependency names, not the path of the binary being inspected. This
# supports otool -L, readelf -d, dumpbin /DEPENDENTS and llvm-objdump -p.
function(iigeneraldocument_find_qt_import output result_variable)
    string(REPLACE "\r\n" "\n" _text "${output}")
    string(REPLACE "\n" ";" _lines "${_text}")
    set(_found "")
    foreach(_line IN LISTS _lines)
        string(STRIP "${_line}" _line)
        string(TOLOWER "${_line}" _lower)
        set(_dependency "")
        if(_lower MATCHES "\\(needed\\).*\\[([^]]+)\\]")
            set(_dependency "${CMAKE_MATCH_1}")
        elseif(_lower MATCHES "^dll name:[ \t]*(.+\\.dll)$")
            set(_dependency "${CMAKE_MATCH_1}")
        elseif(_lower MATCHES "^([^ \t]+\\.dll)$")
            set(_dependency "${CMAKE_MATCH_1}")
        elseif(_lower MATCHES "^(.+) \\(compatibility version")
            set(_dependency "${CMAKE_MATCH_1}")
        endif()
        if(NOT _dependency STREQUAL "")
            string(REGEX REPLACE "^.*[/\\\\]" "" _name "${_dependency}")
            if(_name MATCHES "^(lib)?qt([0-9]+)?([a-z._-]|$)")
                set(_found "${_dependency}")
                break()
            endif()
        endif()
    endforeach()
    set(${result_variable} "${_found}" PARENT_SCOPE)
endfunction()

function(iigeneraldocument_find_qt_symbol output result_variable)
    set(_found "")
    if("${output}" MATCHES "QObject|QString|QByteArray|QMetaObject|qt_metacall|qt_metacast|_ZNK?[0-9]+Q[A-Z]")
        set(_found "${CMAKE_MATCH_0}")
    endif()
    set(${result_variable} "${_found}" PARENT_SCOPE)
endfunction()
