include("${IIGENERALDOCUMENT_SOURCE_DIR}/tests/QtImportAudit.cmake")
file(GLOB_RECURSE _authored_files "${IIGENERALDOCUMENT_SOURCE_DIR}/src/*.h" "${IIGENERALDOCUMENT_SOURCE_DIR}/src/*.hpp" "${IIGENERALDOCUMENT_SOURCE_DIR}/src/*.cpp" "${IIGENERALDOCUMENT_SOURCE_DIR}/tests/*.cpp")
foreach(_file IN LISTS _authored_files)
    file(READ "${_file}" _code)
    if(_code MATCHES "#[ \t]*include[ \t]*[<\"](Qt|Q[A-Z][^P])" OR _code MATCHES "QObject|QByteArray|QString|QProcess|QTemporaryDir|QJsonDocument|QXmlStream|Qt::")
        message(FATAL_ERROR "Qt dependency in authored document code: ${_file}")
    endif()
endforeach()
if(IIGENERALDOCUMENT_CROSS_COMPILING)
    message(STATUS "Skipping host binary inspection for a cross-compiled target")
    return()
endif()

if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
    find_program(_inspector NAMES otool REQUIRED)
    set(_inspector_options -L)
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    find_program(_inspector NAMES readelf llvm-readelf REQUIRED)
    set(_inspector_options -d)
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
    find_program(_inspector NAMES dumpbin llvm-objdump REQUIRED)
    if(_inspector MATCHES "[Dd][Uu][Mm][Pp][Bb][Ii][Nn](\\.exe)?$")
        set(_inspector_options /DEPENDENTS)
    else()
        set(_inspector_options -p)
    endif()
endif()

if(_inspector)
    # The document library has two SDK-owned dynamic dependencies. Checking
    # only its own load commands misses Qt imported by one of those libraries.
    foreach(_name IN ITEMS IIGENERALDOCUMENT_LIBRARY IIGENERALDOCUMENT_PDF_LIBRARY
            IIGENERALDOCUMENT_NATIVE_PROVIDER_LIBRARY)
        if(NOT DEFINED ${_name} OR NOT EXISTS "${${_name}}")
            message(FATAL_ERROR "Missing binary for native dependency audit: ${_name}")
        endif()
        set(_library "${${_name}}")
        if(_library MATCHES "\\.(a|lib)$")
            continue()
        endif()
        execute_process(COMMAND "${_inspector}" ${_inspector_options} "${_library}"
            OUTPUT_VARIABLE _links ERROR_VARIABLE _error RESULT_VARIABLE _result)
        if(NOT _result EQUAL 0)
            message(FATAL_ERROR "Cannot inspect ${_library}: ${_error}")
        endif()
        iigeneraldocument_find_qt_import("${_links}" _qt_import)
        if(NOT _qt_import STREQUAL "")
            message(FATAL_ERROR "Qt runtime dependency in ${_library}: ${_qt_import}")
        endif()
        if(_name STREQUAL "IIGENERALDOCUMENT_LIBRARY" AND
           _links MATCHES "libiiXml\\.|libiiHtmlBlock\\.|libiiFileProvider\\.0")
            message(FATAL_ERROR "Legacy Qt-bearing SDK dependency in ${_library}: ${_links}")
        endif()
    endforeach()
endif()

if(UNIX AND DEFINED IIGENERALDOCUMENT_NM AND EXISTS "${IIGENERALDOCUMENT_NM}"
        AND DEFINED IIGENERALDOCUMENT_MARKUP_LIBRARY AND EXISTS "${IIGENERALDOCUMENT_MARKUP_LIBRARY}")
    execute_process(COMMAND "${IIGENERALDOCUMENT_NM}" -u "${IIGENERALDOCUMENT_MARKUP_LIBRARY}"
        OUTPUT_VARIABLE _symbols ERROR_VARIABLE _error RESULT_VARIABLE _result)
    iigeneraldocument_find_qt_symbol("${_symbols}" _qt_symbol)
    if(NOT _result EQUAL 0 OR NOT _qt_symbol STREQUAL "")
        message(FATAL_ERROR "Qt symbols in native markup archive: ${_qt_symbol} ${_error}")
    endif()
endif()
