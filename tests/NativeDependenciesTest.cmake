file(GLOB_RECURSE _authored_files "${IIGENERALDOCUMENT_SOURCE_DIR}/src/*.h" "${IIGENERALDOCUMENT_SOURCE_DIR}/src/*.hpp" "${IIGENERALDOCUMENT_SOURCE_DIR}/src/*.cpp" "${IIGENERALDOCUMENT_SOURCE_DIR}/tests/*.cpp")
foreach(_file IN LISTS _authored_files)
    file(READ "${_file}" _code)
    if(_code MATCHES "#[ \t]*include[ \t]*[<\"](Qt|Q[A-Z][^P])" OR _code MATCHES "QObject|QByteArray|QString|QProcess|QTemporaryDir|QJsonDocument|QXmlStream|Qt::")
        message(FATAL_ERROR "Qt dependency in authored document code: ${_file}")
    endif()
endforeach()
if(DEFINED IIGENERALDOCUMENT_LIBRARY AND CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
    execute_process(COMMAND /usr/bin/otool -L "${IIGENERALDOCUMENT_LIBRARY}" OUTPUT_VARIABLE _links RESULT_VARIABLE _result)
    if(NOT _result EQUAL 0 OR _links MATCHES "Qt|iiXml|iiHtmlBlock|libiiFileProvider\\.0")
        message(FATAL_ERROR "Unexpected full-module runtime dependencies: ${_links}")
    endif()
endif()
